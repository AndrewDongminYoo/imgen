{
  "name": "imgen",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run src/index.tsx",
    "dev": "bun run --watch src/index.tsx",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "bun build --compile --outfile dist/imgen src/index.tsx",
    "dist": "bun run build && cd dist && tar -czf imgen-darwin-arm64.tar.gz imgen && shasum -a 256 imgen-darwin-arm64.tar.gz",
    "probe:paste": "bun run dev/paste-probe.tsx",
    "probe:protocol": "bun run dev/protocol-probe.tsx",
    "probe:key": "bun run dev/key-probe.tsx"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.18"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@opentui/core": "^0.5.3",
    "@opentui/react": "^0.5.3",
    "react": "^19.2.6"
  },
  "version": "0.6.0",
  "bin": {
    "imgen": "./src/index.tsx"
  },
  "license": "MIT",
  "description": "A terminal browser and generator for the images the Codex CLI makes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndrewDongminYoo/imgen.git"
  }
}
